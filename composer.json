{
    "name": "anton-barinov/ai-function-caller-php",
    "description": "Bridge PHP 8.1+ DTOs and Function Calling / Structured Outputs for OpenAI, Anthropic Claude, and Google Gemini with strict schema generation and automatic hydration.",
    "keywords": [
        "ai",
        "function-calling",
        "structured-outputs",
        "openai",
        "anthropic",
        "claude",
        "gemini",
        "json-schema",
        "dto",
        "hydrator",
        "llm",
        "type-safety"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton Barinov",
            "homepage": "https://github.com/Anton-Barinov"
        }
    ],
    "require": {
        "php": ">=8.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "AiFunctionCaller\\": "src/"
        },
        "files": [
            "src/autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "AiFunctionCaller\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ai-caller"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
